class Solution {
    public int searchInsert(int[] num, int target) {
        int low=0;
        int high=num.length-1;
        while(low<=high){
            int mid=(low+high)/2;
            if(target==num[mid]){
                return mid;
            }else if(target>num[mid]) {
                low=mid+1;
            }else{
                high=mid-1;
            }
        }
        return low;
    }
}
